<?xml version="1.0" encoding="utf-8"?>
<!-- Signs every .exe in the uploaded zip: the program, the setup bootstrapper engine, and the final setup. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
